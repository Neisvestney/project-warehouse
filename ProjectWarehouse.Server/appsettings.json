{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ProjectWarehouse",
    "Audience": "ProjectWarehouse",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Seed": {
    "AdminUsername": "admin"
  },
  "DataFiles": {
    "StorageRoot": "/data/files",
    "MaxFileSizeBytes": 26214400,
    "OrphanTtlHours": 48,
    "GcCron": "0 30 3 * * ?",
    "GcBatchSize": 500,
    "StatsCacheSeconds": 300
  },
  "Observability": {
    "OtlpEndpoint": "http://otel-collector:4317",
    "ServiceName": "projectwarehouse.server",
    "TraceSampleRatio": 1.0,
    "MaxClientPayloadBytes": 1048576
  },
  "Marketplaces": {
    "KeyRingPath": "/keys",
    "SyncScanCron": "0 * * * * ?",
    "DefaultSyncIntervalMinutes": 30,
    "Ozon": {
      "BaseUrl": "https://api-seller.ozon.ru",
      "TimeoutSeconds": 60,
      "PageDelayMs": 200,
      "LabelBatchSize": 20
    },
    "Labels": {
      "MaxArticlesOnLabel": 2,
      "FontResourceName": "ProjectWarehouse.Server.Resources.Fonts.LabelFont.ttf",
      "FontSize": 5,
      "Margin": 1
    }
  }
}
