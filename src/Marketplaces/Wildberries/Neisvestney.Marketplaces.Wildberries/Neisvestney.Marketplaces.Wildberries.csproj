<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Typed Wildberries API clients, one per API host, generated from sanitized OpenAPI specs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- compiled into each library as internal: every package stays dependency-free -->
    <Compile Include="..\..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
