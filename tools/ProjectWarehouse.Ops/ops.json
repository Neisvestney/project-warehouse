{
  "includeConfig": "./ops.local.json",

  "services": {
    "server": {
      "dockerfile": "src/ProjectWarehouse.Server/Dockerfile",
      "context": ".",
      "image": "projectwarehouse.server",
      "composeService": "projectwarehouse.server",
      "tagVariable": "SERVER_IMAGE_TAG"
    }
  },

  "targets": {
    "local": {
      "kind": "local",
      "danger": false,
      "composeFile": "docker-compose.yml",
      "services": ["server"],
      "volumes": {
        "keys": { "path": "{projectDir}/src/ProjectWarehouse.Server/keys" },
        "datafiles": { "path": "{projectDir}/src/ProjectWarehouse.Server/.localdata/files" }
      },
      "postgres": {
        "service": "postgres",
        "user": "postgres",
        "database": "projectwarehouse"
      }
    }
  }
}
